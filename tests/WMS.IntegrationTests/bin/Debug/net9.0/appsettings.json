{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/wms-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=WmsDb;Trusted_Connection=True;"
  },
  "JwtSettings": {
  "SecretKey": "ThisIsMySuperStrongJwtSecretKeyForWMSApplication2026Production",
  "Issuer": "WMS.API",
  "Audience": "WMS.Client",
  "AccessTokenExpiryMinutes": 60,
  "RefreshTokenExpiryDays": 7
},
  "AllowedOrigins": [
    "http://localhost:4200",
    "https://your-prod-domain.com"
  ],
  "KeyVault": {
    "VaultUri": "https://your-keyvault.vault.azure.net/"
  },
  "ApplicationInsights": {
    "ConnectionString": "YOUR_APP_INSIGHTS_CONNECTION_STRING"
  }
}
